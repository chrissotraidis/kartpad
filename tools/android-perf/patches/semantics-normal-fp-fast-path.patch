+// FinishScalarFp for its most common input: no exception and a finite, normal
+// result. Then no exception or summary bit changes, the destination is always
+// written, and FPRF is +/- normal. Single precision rounds once to float (the
+// same conversion ForceSingle makes) and must still be normal; with NI set, a
+// value below the single normal range takes the exact path, which flushes it.
+// Returns false for every other case, which callers send to FinishScalarFp.
+inline bool TryFinishNormalScalarFp(std::uint32_t fpscr_value, double value,
+                                    bool single_precision,
+                                    ScalarFpResult& result) noexcept {
+  if (single_precision) {
+    if ((fpscr_value & fpscr::NI) != 0 && !(std::abs(value) >= 0x1p-126))
+      return false;
+    const float rounded = static_cast<float>(value);
+    const auto bits = std::bit_cast<std::uint32_t>(rounded);
+    const auto exponent = bits & 0x7f800000u;
+    if (exponent == 0 || exponent == 0x7f800000u)
+      return false;
+    result = {static_cast<double>(rounded),
+              SetFprf(fpscr_value, (bits & 0x80000000u) != 0 ? 0x08u : 0x04u),
+              0, true};
+    return true;
+  }
+  const auto bits = std::bit_cast<std::uint64_t>(value);
+  const auto exponent = bits & 0x7ff0000000000000ULL;
+  if (exponent == 0 || exponent == 0x7ff0000000000000ULL)
+    return false;
+  result = {value,
+            SetFprf(fpscr_value, (bits >> 63) != 0 ? 0x08u : 0x04u), 0, true};
+  return true;
+}
