+#define PpcFnmsubStateInline(...) PpcFnmsubStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
+#define PpcFnmsubsStateInline(...) PpcFnmsubsStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
