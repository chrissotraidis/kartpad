+
+// Translated functions already receive the executing guest CPU as \`ctx\`.
+// In the game pack, the scalar adapters use it directly instead of reading
+// g_currentCpuContext, which the pack reaches through Android/API 28 emulated
+// TLS (__emutls_get_address + pthread_getspecific on every FP instruction).
+// A null context or a null guest stack still takes CurrentCpuContext() and its
+// fatal diagnostics. KARTPAD_SCALAR_CONTEXT_CHECK aborts if the passed context
+// ever differs from the thread's current one; KARTPAD_SCALAR_TLS_CONTEXT keeps
+// the previous lookup.
+#if defined(MKW_GAME_PACK_MODULE) && !defined(KARTPAD_SCALAR_TLS_CONTEXT)
+inline CpuContext* KartPadScalarCpu(CpuContext* local)
+{
+#if defined(KARTPAD_SCALAR_CONTEXT_CHECK)
+    if (local != g_currentCpuContext)
+        std::abort();
+#endif
+    if (__builtin_expect(local == nullptr || local->gpr[1] == 0, 0))
+        return CurrentCpuContext();
+    return local;
+}
+// State-free leaf functions (RECOMP_STATE_FREE_ABI) have no ctx parameter; there
+// the name finds this placeholder and the adapters keep the TLS lookup.
+struct KartPadNoLocalCpuContext {};
+inline constexpr KartPadNoLocalCpuContext ctx{};
+inline CpuContext* KartPadScalarCpu(KartPadNoLocalCpuContext) { return CurrentCpuContext(); }
+#define PpcFaddsStateInline(...) PpcFaddsStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
