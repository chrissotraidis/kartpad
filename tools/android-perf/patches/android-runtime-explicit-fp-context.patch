+#define PpcFsubStateInline(...) PpcFsubStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
+#define PpcFmulStateInline(...) PpcFmulStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
+#define PpcFdivStateInline(...) PpcFdivStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
+#define PpcFctiwzStateInline(...) PpcFctiwzStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
+#define PpcFmaddsStateInline(...) PpcFmaddsStateCtxInline(KartPadScalarCpu(ctx), __VA_ARGS__)
