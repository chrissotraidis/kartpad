+    // KartPad #304: accept ImgTec's Vulkan floor of 64 components (14 variables),
+    // retaining both reserved vec4 slots. Other vendors retain the original minimum.
+    // Report the actual supported limit below; do not advertise 16 on a 14-variable GPU.
+    const uint32_t interStageVariablesBase =
+        gpu_info::IsImgTec(GetVendorId())
+            ? std::min(baseLimits.v1.maxInterStageShaderVariables, 14u)
+            : baseLimits.v1.maxInterStageShaderVariables;
+    if (vkLimits.maxVertexOutputComponents < interStageVariablesBase * 4 + 8 ||
+        vkLimits.maxFragmentInputComponents < interStageVariablesBase * 4 + 8) {
         return DAWN_INTERNAL_ERROR("Insufficient Vulkan limits for maxInterStageShaderVariables");
     }
