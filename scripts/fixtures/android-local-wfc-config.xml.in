  <pcountRefreshInterval>600</pcountRefreshInterval>
  <username>kartpad</username>
  <password>kartpad-local-only</password>
  <databaseAddress>127.0.0.1:@POSTGRES_PORT@</databaseAddress>
  <databaseName>wwfc</databaseName>
  <logLevel>4</logLevel>
  <logOutput>StdOut</logOutput>
  <friendBotPID>0</friendBotPID>
  <apiSecret>kartpad-local-only</apiSecret>
  <serverName>KartPad Local WFC</serverName>
</Config>
