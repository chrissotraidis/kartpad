{
  "schema_version": 1,
  "id": "kartpad",
  "name": "KartPad",
  "game": "Mario Kart Wii (Wii, RMCP01)",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "wii-disc",
      "formats": [
        "wbfs"
      ],
      "description": "Your own PAL RMCP01 disc image. The current profile accepts one pinned WBFS image; ISO and RVZ variants are planned."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "command": [
        "/bin/bash",
        "{repo}/scripts/build-user-ipa.sh",
        "build",
        "{disc}",
        "--work-root",
        "{work}",
        "--output",
        "{output}",
        "--jobs",
        "{jobs}"
      ],
      "modes": {
        "full": []
      },
      "output": "ipa",
      "check": "kartpad-ipa"
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    },
    "android": {
      "hosts": {
        "macos-arm64": "planned",
        "linux-x86_64": "planned",
        "windows-x86_64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 60,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "dotnet",
        "version_args": [
          "--version"
        ],
        "min_version": "8"
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      }
    ]
  },
  "stages": [
    "preflight",
    "extract",
    "translate",
    "compile",
    "app",
    "package"
  ],
  "publication": {
    "public_binaries": false,
    "reason": "Personal builds contain translated game code; public releases are source only."
  }
}
